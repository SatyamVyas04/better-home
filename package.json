{
  "name": "better-home",
  "version": "2.1.0",
  "private": true,
  "description": "A minimal, delightful new-tab replacement with tasks, quick links, and a mood calendar.",
  "type": "module",
  "scripts": {
    "build": "wxt prepare && tsc --noEmit && wxt build",
    "dev": "wxt",
    "fix": "bunx ultracite fix",
    "fix:unsafe": "bunx ultracite fix --unsafe",
    "postinstall": "wxt prepare",
    "lint": "bunx ultracite check",
    "prepare": "husky",
    "release": "dotenv release-it --",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/storage": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@wxt-dev/module-react": "^1.2.2",
    "archiver": "^8.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "release-it": "^21.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "ultracite": "7.11.1",
    "wxt": "^0.21.4"
  }
}
